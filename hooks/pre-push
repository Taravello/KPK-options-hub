#!/bin/sh
# Security guard (standing rule, replicated from kpk-aum-dashboard):
#   Refuse to push .env-style secret files in any pushed tree.
#   (This project needs no secrets at all - anything that looks like one
#    is a mistake by construction.)
# Activate after cloning with:  git config core.hooksPath hooks
FAIL=0
while read local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in 0000000000000000000000000000000000000000) continue;; esac
  if git ls-tree -r --name-only "$local_sha" | grep -qE '(^|/)\.env(\.|$)'; then
    echo "PUSH BLOCKED: a .env file is present in the pushed tree ($local_ref)."
    FAIL=1
  fi
done
exit $FAIL
